# Copy to .env and fill in your Supabase connection details.
NODE_ENV=development
PORT=8086
CORS_ORIGIN=http://localhost:5173

# The Supabase session pooler connection string, from the dashboard:
# Connect -> ORM (or Direct) -> the string on port 5432.
#
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Use the SESSION pooler (port 5432), not the transaction pooler (port 6543):
# the transaction pooler does not support prepared statements, which TypeORM
# relies on. The direct connection (db.<project-ref>.supabase.co) also works but
# is IPv6-only unless the project has the IPv4 add-on.
#
# If the password contains @ : / ? # & = + or a space it must be percent-encoded,
# or it will silently break the URL. An alphanumeric password avoids the problem
# everywhere it gets pasted, not just here.
#
# The schema is owned by the migrations in src/migrations and applied on boot,
# so an empty database only needs `npm run start:dev`.
DATABASE_URL=

# TLS, named after libpq's sslmode.
#   require    encrypt AND verify the server certificate
#   no-verify  encrypt but do not verify — no protection against a man in the middle
#   disable    plaintext — local containers only
#
# Supabase serves a certificate issued by its own "Supabase Intermediate 2021 CA",
# which is not in Node's trust store, so a bare `require` fails with
# SELF_SIGNED_CERT_IN_CHAIN. Two ways forward:
#
#   1. Verified (preferred). Download the certificate from the dashboard,
#      Settings -> Database -> SSL Configuration, save it inside backend/, and:
#         DB_SSL=require
#         DB_SSL_CA=./prod-ca-2021.crt
#      The traffic is then both encrypted and authenticated.
#
#   2. Encrypted only. DB_SSL=no-verify, and leave DB_SSL_CA empty.
#      Traffic is still encrypted, but nothing proves the server is Supabase.
DB_SSL=no-verify
DB_SSL_CA=

# Auth
# Any long random string. Leave this line commented out in development and the
# app falls back to `dev-only-secret`. Do NOT ship it as an empty `JWT_SECRET=`:
# dotenv reads that as an empty string, which is not undefined, so the fallback
# would not apply and every sign-in would fail.
# JWT_SECRET=

# The password given to every account created by `npm run seed`. There is no
# default: the seeder throws if this is unset, so that no credential is ever
# committed. Use 8+ characters including a digit, or the accounts it creates
# will not satisfy the register rule and you will not be able to sign in.
SEED_PASSWORD=
