# Copy to .env and fill in the local Postgres credentials.
NODE_ENV=development
PORT=8086
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# trailshare_dev, not trailshare: an unrelated Flyway-managed `trailshare`
# database exists on this machine and must not be touched.
DB_NAME=trailshare_dev

# Auth
# Any long random string. Outside production the app falls back to `dev-only-secret`.
JWT_SECRET=
