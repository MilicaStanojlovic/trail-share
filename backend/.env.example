# Copy to .env and fill in the local Postgres credentials.
NODE_ENV=development
PORT=8086
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# trailshare_dev, not trailshare: an unrelated Flyway-managed `trailshare`
# database exists on this machine and must not be touched.
DB_NAME=trailshare_dev

# Auth
# Any long random string. Leave this line commented out in development and the
# app falls back to `dev-only-secret`. Do NOT ship it as an empty `JWT_SECRET=`:
# dotenv reads that as an empty string, which is not undefined, so the fallback
# would not apply and every sign-in would fail.
# JWT_SECRET=
